# ============================================================
# 小智配置台 · 服务端密钥配置模板
# 用法：复制本文件为 .env（同目录），填入真实密钥后重启服务。
# 安全提示：.env 已被 .gitignore 忽略，切勿把真实密钥写进代码或提交。
# ============================================================

# DeepSeek 官方 API Key（在 https://platform.deepseek.com/api_keys 申请）
DEEPSEEK_API_KEY=sk-REPLACE_ME

# 默认模型名（官方文档当前为 deepseek-flash / deepseek-v4-pro）
# 前端资源里的 modelId 优先；此处仅作缺省兜底
DEEPSEEK_MODEL=deepseek-flash

# 思考模式：none=关闭(响应更快) / low / high / max
DEEPSEEK_REASONING=none

# 后端监听端口（前端 Vite 代理会转发 /api 到这里）
API_PORT=8787

# endpoint 主机白名单，防止密钥被转发到任意地址（SSRF 防护）
# 用英文逗号分隔；新增其它供应商时在此追加其 API 域名
ALLOWED_API_HOSTS=api.deepseek.com

# ---- 可选：其它供应商（如需接入，取消注释并加入白名单）----
# DASHSCOPE_API_KEY=sk-REPLACE_ME
# OPENAI_API_KEY=sk-REPLACE_ME
# ALLOWED_API_HOSTS=api.deepseek.com,dashscope.aliyuncs.com,api.openai.com
